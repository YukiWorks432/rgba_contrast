{
  "lineWidth": 100,
  "indentWidth": 2,
  "newLineKind": "lf",
  "markdown": {
    "textWrap": "maintain"
  },
  "json": {
    "trailingCommas": "maintain"
  },
  "includes": ["**/*.md", "**/*.json", "**/*.jsonc"],
  "excludes": ["**/target/**", "plans/**"],
  "plugins": [
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    "https://plugins.dprint.dev/markdown-0.26.0.wasm"
  ]
}
